---
import type { Text } from '../i18n/text';
import Icon from './Icon.astro';
interface Props { t: Text }
const { t } = Astro.props;
---
<section class="wrap section" id="features" aria-labelledby="features-title">
  <h2 class="center" id="features-title">{t.features.title}</h2>
  <div class="grid3">
    {t.features.items.map((f) => (
      <article class="card">
        <span class="icon-box"><Icon name={f.icon} /></span>
        <h3>{f.title}</h3>
        <p class="muted">{f.body}</p>
      </article>
    ))}
  </div>
</section>
