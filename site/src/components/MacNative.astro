---
import type { Text } from '../i18n/text';
interface Props { t: Text; base: string }
const { t, base } = Astro.props;
---
<section class="wrap section" aria-labelledby="mac-title">
  <h2 class="center" id="mac-title">{t.mac.title}</h2>
  <p class="center muted">{t.mac.lead}</p>
  <div class="mac">
    <img class="shot mac-window" src={`${base}/shots/${t.lang}/drop.png`} width="420" height="542" alt={t.mac.windowAlt} loading="lazy" decoding="async" />
    <figure class="mac-compact">
      <img class="shot" src={`${base}/shots/${t.lang}/compact.png`} width="200" height="200" alt={t.mac.compactAlt} loading="lazy" decoding="async" />
      <figcaption class="muted small">{t.mac.compactCaption}</figcaption>
    </figure>
    <div>
      <h3>{t.mac.styleTitle}</h3>
      <p class="muted">{t.mac.styleBody}</p>
    </div>
  </div>
</section>
