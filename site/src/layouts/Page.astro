---
import { text, repo, site, type Lang } from '../i18n/text';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Peek from '../components/Peek.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Encoding from '../components/Encoding.astro';
import MacNative from '../components/MacNative.astro';
import Formats from '../components/Formats.astro';
import Install from '../components/Install.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = text[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = `${site}${t.path}`;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ZipPeek',
  operatingSystem: 'macOS 14 or later',
  applicationCategory: 'UtilitiesApplication',
  description: t.description,
  url,
  downloadUrl: `${repo}/releases/latest`,
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  inLanguage: ['en', 'ja'],
};
---
<!doctype html>
<html lang={t.lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{t.title}</title>
  <meta name="description" content={t.description} />
  <link rel="canonical" href={url} />
  <link rel="icon" type="image/png" href={`${base}/icon.png`} />
  <link rel="apple-touch-icon" href={`${base}/icon.png`} />
  <link rel="alternate" hreflang="en" href={`${site}/`} />
  <link rel="alternate" hreflang="ja" href={`${site}/ja/`} />
  <link rel="alternate" hreflang="x-default" href={`${site}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={t.title} />
  <meta property="og:description" content={t.description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={`${site}/og-${t.lang}.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0e1016" media="(prefers-color-scheme: dark)" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
</head>
<body>
  <Header t={t} base={base} />
  <main id="main">
    <Hero t={t} base={base} />
    <Peek t={t} base={base} />
    <Features t={t} />
    <HowItWorks t={t} />
    <Encoding t={t} />
    <MacNative t={t} base={base} />
    <Formats t={t} />
    <Install t={t} />
    <Faq t={t} />
  </main>
  <Footer t={t} base={base} />

  <style is:global>
    :root {
      --bg: #ffffff;
      --fg: #14161c;
      --mut: #5b6270;
      --line: #e6e8ee;
      --card: #f7f8fb;
      --surface: #ffffff;
      --acc: #2f5bea;
      --acc-fg: #ffffff;
      --soft: #eef2ff;
      --bad: #b4380a;
      --glow: rgba(124, 155, 255, 0.35);
      --shadow: 0 24px 56px -20px rgba(27, 37, 80, 0.35);
      color-scheme: light;
      font-family: -apple-system, BlinkMacSystemFont, "Inter", "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Noto Sans JP", "Segoe UI", sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0e1016;
        --fg: #e8eaf0;
        --mut: #9aa1ae;
        --line: #262b38;
        --card: #151821;
        --surface: #151821;
        --acc: #7c9bff;
        --acc-fg: #0b0e18;
        --soft: #1b2340;
        --bad: #ff9b6a;
        --glow: rgba(61, 107, 255, 0.35);
        --shadow: 0 24px 56px -20px rgba(0, 0, 0, 0.7);
        color-scheme: dark;
      }
    }
    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; scroll-padding-top: 88px; }
    @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { transition: none !important; } }
    body { margin: 0; background: var(--bg); color: var(--fg); line-height: 1.7; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
    img { max-width: 100%; height: auto; }
    a { color: var(--acc); text-underline-offset: 3px; }
    :focus-visible { outline: 3px solid var(--acc); outline-offset: 3px; border-radius: 8px; }
    h1, h2, h3 { line-height: 1.15; margin: 0; letter-spacing: -0.01em; text-wrap: balance; }
    h2 { font-size: clamp(28px, 4.2vw, 40px); font-weight: 800; }
    h3 { font-size: 20px; font-weight: 700; }
    p { margin: 0; }
    .wrap { max-width: 960px; margin: 0 auto; padding-left: max(20px, env(safe-area-inset-left)); padding-right: max(20px, env(safe-area-inset-right)); }
    .section { margin-top: 110px; }
    .center { text-align: center; }
    .muted { color: var(--mut); }
    .small { font-size: 14px; }
    .accent { color: var(--acc); }
    .eyebrow { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; color: var(--acc); margin-bottom: 14px; }
    :lang(ja) .eyebrow { letter-spacing: 0.06em; }
    .lead-s { margin-top: 14px; font-size: 18px; max-width: 46em; }
    .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: var(--surface); padding: 8px 14px; border-radius: 10px; }
    .skip:focus { left: 12px; }

    /* ボタン */
    .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 26px; border-radius: 999px; background: var(--acc); color: var(--acc-fg); font-weight: 650; font-size: 16px; text-decoration: none; border: 1.5px solid transparent; transition: transform .15s ease, filter .15s ease; }
    .btn:hover { transform: translateY(-1px); filter: brightness(1.06); }
    .btn-ghost { background: var(--surface); color: var(--fg); border-color: var(--line); }
    .btn-small { min-height: 36px; padding: 0 16px; font-size: 14px; }
    .btn-invert { background: #ffffff; color: #2f5bea; }

    /* ヘッダー */
    .site-header { position: sticky; top: 0; z-index: 50; background: color-mix(in srgb, var(--bg) 82%, transparent); backdrop-filter: saturate(1.6) blur(16px); -webkit-backdrop-filter: saturate(1.6) blur(16px); border-bottom: 1px solid var(--line); }
    .header-inner { display: flex; align-items: center; gap: 24px; height: 64px; }
    .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--fg); }
    .brand img { border-radius: 8px; }
    .wordmark { font-weight: 800; font-size: 22px; letter-spacing: -0.02em; }
    .wordmark span { color: var(--acc); }
    .nav { display: flex; gap: 26px; margin-left: auto; }
    .nav a, .lang { color: var(--mut); text-decoration: none; font-size: 15px; font-weight: 500; }
    .nav a:hover, .lang:hover { color: var(--fg); }
    .header-actions { display: flex; align-items: center; gap: 18px; }
    @media (max-width: 760px) { .nav { display: none; } .header-actions { margin-left: auto; } }

    /* ヒーロー */
    .hero { position: relative; overflow: hidden; padding-top: 72px; }
    .hero::before { content: ""; position: absolute; inset: -10% -20% auto; height: 820px; background: radial-gradient(closest-side, var(--glow), transparent 75%); pointer-events: none; z-index: -1; }
    .hero-inner { text-align: center; }
    .hero h1 { font-size: clamp(38px, 7.2vw, 66px); font-weight: 800; letter-spacing: -0.025em; }
    :lang(ja) .hero h1 { font-size: clamp(26px, 7.2vw, 58px); letter-spacing: -0.01em; line-height: 1.25; }
    .hero h1 .line { display: block; }
    .hero .lead { margin: 22px auto 0; max-width: 36em; font-size: clamp(17px, 2.2vw, 20px); color: var(--mut); }
    .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 32px; }
    .meta { margin-top: 16px; font-size: 13px; color: var(--mut); }
    .shot { display: block; border-radius: 18px; filter: drop-shadow(var(--shadow)); }
    .hero-shot { margin: 48px auto 0; width: 100%; max-width: 900px; }
    @media (max-width: 560px) { .actions .btn { width: 100%; } }

    /* パネル */
    .panel { background: var(--card); border-radius: 32px; padding: clamp(24px, 5vw, 56px); }
    .peek { display: grid; grid-template-columns: 1.15fr 1fr; gap: 48px; align-items: center; }
    .peek h2 { font-size: clamp(26px, 3.4vw, 34px); }
    .peek .muted { margin-top: 16px; font-size: 18px; }
    .chip { display: inline-block; margin-top: 22px; padding: 8px 18px; border-radius: 999px; background: var(--soft); color: var(--acc); font-weight: 650; font-size: 14px; }
    @media (max-width: 760px) { .peek { grid-template-columns: 1fr; } .peek .shot { order: 2; } }

    /* 機能カード */
    .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 44px; padding: 0; list-style: none; }
    @media (max-width: 860px) { .grid3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 560px) { .grid3 { grid-template-columns: 1fr; } }
    .card { background: var(--surface); border: 1.5px solid var(--line); border-radius: 24px; padding: 28px; }
    .card h3 { margin-top: 20px; }
    .card .muted { margin-top: 10px; font-size: 15px; }
    .icon-box { display: inline-grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--soft); color: var(--acc); }

    /* しくみの図 */
    .zipbar { display: flex; gap: 8px; align-items: stretch; margin: 40px 0 0; padding: 8px; border: 1.5px solid var(--line); border-radius: 16px; background: var(--card); }
    .blocks { flex: 1; display: grid; grid-template-columns: repeat(14, 1fr); gap: 6px; }
    .blocks span { height: 44px; border-radius: 8px; background: var(--line); }
    @media (max-width: 560px) { .blocks { grid-template-columns: repeat(7, 1fr); } .blocks span:nth-child(n+8) { display: none; } }
    .toc { display: grid; place-items: center; padding: 0 18px; border-radius: 10px; background: var(--acc); color: var(--acc-fg); font-weight: 700; font-size: 14px; }
    .zipbar-labels { display: flex; justify-content: space-between; gap: 12px; margin-top: 14px; }
    .result-row { display: flex; justify-content: flex-end; margin-top: 18px; }
    .result { display: inline-block; padding: 14px 22px; border-radius: 16px; background: var(--soft); color: var(--acc); font-weight: 650; }

    /* 文字化け */
    .enc h2 { font-size: clamp(26px, 3.6vw, 36px); }
    .enc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 32px; }
    @media (max-width: 640px) { .enc-grid { grid-template-columns: 1fr; } }
    .enc-box { background: var(--surface); border: 1.5px solid var(--line); border-radius: 20px; padding: 24px 28px; display: grid; gap: 14px; }
    .enc-label { font-size: 14px; font-weight: 650; }
    .enc-label.bad { color: var(--bad); }
    .enc-label.good { color: var(--acc); }
    .enc-name { font-size: 26px; font-weight: 650; }
    .enc-name.garbled { color: var(--mut); }

    /* Macらしさ */
    .mac { display: grid; grid-template-columns: auto auto 1fr; gap: 56px; align-items: center; margin-top: 48px; }
    .mac-window { width: 330px; }
    .mac-compact { margin: 0; display: grid; justify-items: center; gap: 14px; }
    .mac-compact .shot { width: 200px; border-radius: 50px; }
    .mac h3 + .muted { margin-top: 10px; }
    @media (max-width: 860px) { .mac { grid-template-columns: 1fr; justify-items: center; text-align: center; } }

    /* 対応形式 */
    .formats { display: grid; grid-template-columns: auto 1fr; gap: 14px 24px; margin: 28px 0 16px; align-items: start; }
    .formats dt { font-weight: 700; color: var(--mut); padding-top: 6px; }
    .formats dd { margin: 0; }
    .chips { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; padding: 0; list-style: none; }
    .chips li { padding: 6px 16px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); font: 600 14px ui-monospace, "SF Mono", Menlo, monospace; }
    .chips.create li { background: var(--soft); border-color: var(--acc); color: var(--acc); }

    /* 入れ方 */
    .steps { counter-reset: none; }
    .step-head { display: flex; align-items: center; gap: 14px; }
    .step-head h3 { margin: 0; font-size: 18px; }
    .num { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--acc); color: var(--acc-fg); font-weight: 700; }
    .steps .muted { margin-top: 16px; }

    /* よくある質問 */
    .faq { display: grid; gap: 12px; margin-top: 28px; }
    .faq details { border: 1.5px solid var(--line); border-radius: 16px; background: var(--surface); }
    .faq summary { list-style: none; cursor: pointer; padding: 18px 56px 18px 24px; font-weight: 650; font-size: 17px; position: relative; min-height: 44px; }
    .faq summary::-webkit-details-marker { display: none; }
    .faq summary::after { content: "+"; position: absolute; right: 24px; top: 50%; transform: translateY(-50%); font-size: 24px; font-weight: 400; color: var(--mut); }
    .faq details[open] summary::after { content: "−"; }
    .faq details p { padding: 0 24px 20px; }

    /* 最後の誘導とフッター */
    .cta { display: flex; align-items: center; gap: 32px; padding: clamp(28px, 5vw, 56px); border-radius: 32px; background: #2f5bea; color: #ffffff; }
    .cta img { border-radius: 26px; flex: none; }
    .cta-text { flex: 1; }
    .cta h2 { font-size: clamp(26px, 3.6vw, 36px); }
    .cta p { margin-top: 8px; color: #dce4ff; font-size: 18px; }
    @media (max-width: 760px) { .cta { flex-direction: column; text-align: center; } }
    .support { display: flex; align-items: center; gap: 24px; margin-top: 24px; padding: 28px 32px; border: 1.5px solid var(--line); border-radius: 24px; background: var(--surface); }
    .support .heart { flex: none; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 16px; background: #fde7ef; color: #c2185b; font-size: 26px; }
    @media (prefers-color-scheme: dark) { .support .heart { background: #3a1726; color: #ff8ab4; } }
    .support-text { flex: 1; }
    .support h2 { font-size: 22px; }
    .support .muted { margin-top: 6px; font-size: 15px; }
    @media (max-width: 760px) { .support { flex-direction: column; text-align: center; } }
    .site-footer { margin-top: 72px; padding-top: 28px; padding-bottom: 56px; border-top: 1px solid var(--line); display: grid; gap: 10px; }
    .footer-links { display: flex; flex-wrap: wrap; gap: 10px 28px; margin: 0 0 6px; padding: 0; list-style: none; }
    .footer-links a { color: var(--mut); font-size: 14px; font-weight: 500; text-decoration: none; }
    .footer-links a:hover { color: var(--fg); }
  </style>
</body>
</html>
